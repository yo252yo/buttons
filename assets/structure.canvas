		},
		{
			"id":"be942fcfd1f2c3da",
			"type":"text",
			"text":"the life of daniel defoe and how he invented copyright",
			"styleAttributes":{},
			"x":-360,
			"y":60,
			"width":260,
			"height":60
		},
		{
			"id":"d7d0771c52f645ae",
			"type":"text",
			"text":"the life of people he stole all his writings from",
			"styleAttributes":{},
			"x":-660,
			"y":180,
			"width":260,
			"height":80
		},
		{
			"id":"5e0783f54439286d",
			"type":"text",
			"text":"the life of people they stole their writing from",
			"styleAttributes":{},
			"x":-660,
			"y":300,
			"width":260,
			"height":60
		},
		{
			"id":"3fb3783c9599e027",
			"type":"text",
			"text":"the people who implemented his idea and how today theyre at the heart of the ongoing genocide",
			"styleAttributes":{},
			"x":-360,
			"y":190,
			"width":260,
			"height":160
		},
		{
			"id":"76c9365b60a626bf",
			"type":"text",
			"text":"nowadays their ideas are the unquestionned norm, even resulting to mob bullying in so called countercultural game jams",
			"styleAttributes":{},
			"x":-360,
			"y":400,
			"width":260,
			"height":160
		},
		{
			"id":"bc14abcf97c1dfd6",
			"type":"text",
			"text":"sparking a participant to write parabolas",
			"styleAttributes":{},
			"x":-40,
			"y":400,
			"width":140,
			"height":120
		},
		{
			"id":"ff34fc04279b915d",
