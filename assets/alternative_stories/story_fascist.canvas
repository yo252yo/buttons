			"x":-3540,
			"y":-9050,
			"width":226,
			"height":90,
			"color":"5"
		},
		{
			"id":"a90965a03222fcd4",
			"type":"text",
			"text":"Il est temps de faire table rase du passé.\n---\nC'est l'heure d'une nouvelle renaissance.",
