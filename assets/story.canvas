		},
		{
			"id":"e14a7245f36b38df",
			"type":"text",
			"text":"And then i wrote two more",
			"styleAttributes":{},
			"x":-12445,
			"y":8288,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"a8f5434158d26eeb",
			"type":"text",
