			"width":1950,
			"height":1861,
			"color":"1"
		},
		{
			"id":"4c11af20a6c391c8",
			"type":"text",
			"text":"something cryptobro\ngo back to defoe",
			"styleAttributes":{},
			"x":5980,
			"y":9159,
			"width":260,
			"height":179,
			"color":"1"
		},
		{
			"id":"a39a9c20ae56ea71",
