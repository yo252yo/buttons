			"toFloating":false,
			"fromNode":"3df206418f34d8a5",
			"fromSide":"bottom",
			"toNode":"ef60b9e37b51d7da",
			"toSide":"top"
		},
		{
			"id":"9d09a2ebf7496e74",
			"styleAttributes":{},
			"toFloating":false,
			"fromNode":"d3b4516848b37f0d",
			"fromSide":"bottom",
			"toNode":"61c6472d86377400",
			"toSide":"top"
		},
		{
			"id":"4aeaf88356f69ada",
			"styleAttributes":{},
			"toFloating":false,
			"fromNode":"d3b4516848b37f0d",
			"fromSide":"bottom",
			"toNode":"5b4d451a709f0da1",
			"toSide":"top",
			"color":"4"
		},
		{
			"id":"49847fb6411a3290",
			"styleAttributes":{},
			"toFloating":false,
			"fromNode":"5b4d451a709f0da1",
			"fromSide":"bottom",
			"toNode":"18924d63f3bc5fa5",
			"toSide":"top"
		},
		{
			"id":"e0cf37c412535fa0",
			"styleAttributes":{},
			"toFloating":false,
			"fromNode":"18924d63f3bc5fa5",
			"fromSide":"bottom",
			"toNode":"0a424ad760b7b70b",
			"toSide":"top"
		},
		{
			"id":"9da4afafdc246b72",
			"styleAttributes":{},
			"toFloating":false,
			"fromFloating":false,
			"fromNode":"5b4d451a709f0da1",
			"fromSide":"bottom",
			"toNode":"21687949a41e78bc",
			"toSide":"top",
			"color":"4"
		},
		{
			"id":"a6be7f03d78a2401",
